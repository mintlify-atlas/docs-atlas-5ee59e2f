  "keyFeatures": [
    "Seamless vLLM integration on Ascend NPU via hardware plugin interface",
    "Support for Atlas A2 and A3 series NPU hardware",
    "Expert Parallelism (EP) for large-scale MoE model deployment",
    "Prefill-Decode disaggregation with Mooncake backend",
    "ACL Graph mode for optimized NPU kernel execution",
    "W8A8, W4A8, and W4A4 quantization support",
    "Context Parallelism and Tensor Parallelism for long sequences",
    "Speculative decoding (suffix-based) for improved throughput",
    "Multi-modal LLM support (vision-language models)",
    "Kubernetes deployment via Volcano/Athena integration",
    "Dynamic Expert Load Balancing (EPLB)",
    "LoRA adapter support for fine-tuned model serving"
  ],
  "publicApiSurface": [
    "vllm_ascend:register (plugin entrypoint)",
    "LLM(model=...) — offline batched inference via vLLM API",
    "vllm serve <model> — OpenAI-compatible server",
    "SamplingParams — generation configuration",
    "vllm_ascend.envs — environment variable configuration",
    "VLLM_ASCEND_ENABLE_CONTEXT_PARALLEL — enable context parallelism",
    "VLLM_ASCEND_ENABLE_NZ — weight format optimization",
    "VLLM_ASCEND_ENABLE_FUSED_MC2 — fused MC2 operator",
    "DYNAMIC_EPLB — dynamic expert load balancing",
    "SOC_VERSION — target Ascend chip version for build",
    "vllm_ascend.platform.AscendPlatform — NPU platform class",
    "vllm_ascend.worker.NPUModelRunner — NPU model runner"
  ]
